# Enterprise AI Business Operations Agent Environment Configuration

# Backend App Settings
APP_ENV=development
APP_PORT=8000
DEBUG=True
SECRET_KEY=change_this_to_a_secure_random_32_character_string_for_production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration
# Local SQLite default (for seamless local development without external dependencies):
DATABASE_URL=sqlite:///./enterprise_ops.db
# PostgreSQL with pgvector (for Docker or production):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/enterprise_ai_ops

# AI & LLM Provider Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Set MOCK_AI=true to force deterministic mock responses without calling Gemini API
MOCK_AI=false

# Document & RAG Storage
UPLOAD_DIR=./data/uploads
CHUNKS_PER_QUERY=5
SIMILARITY_THRESHOLD=0.65

# Security & CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_SIZE_MB=15
RATE_LIMIT_PER_MINUTE=120
