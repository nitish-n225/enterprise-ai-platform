# ==============================================================================
# Enterprise AI Business Operations Agent - Environment Configuration
# ==============================================================================

# Application Environment & Server Settings
APP_NAME="Enterprise AI Business Operations Agent"
APP_ENV=development
DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Security & Authentication (JWT & Passwords)
# Generate a secure 32+ character key for production (e.g., openssl rand -hex 32)
SECRET_KEY=change_this_to_a_secure_random_32_character_string_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration
# Local SQLite default (zero external dependencies, WAL mode & foreign keys enabled):
DATABASE_URL=sqlite:///./enterprise_ops.db
# PostgreSQL with pgvector (for Docker Compose or Cloud Production):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/enterprise_ai_ops
# In Docker Compose:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/enterprise_ai_ops

# PostgreSQL Container Credentials (used by docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=enterprise_ai_ops

# Google Gemini LLM Configuration
# Leave blank to run safely in Transparent Mock Mode with simulated tool reasoning
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Set MOCK_AI=true to force deterministic mock responses even if an API key is present
MOCK_AI=false

# Document Ingestion & Vector RAG Settings
UPLOAD_DIR=./data/uploads
REPORTS_DIR=./data/reports
MAX_UPLOAD_SIZE_MB=15
CHUNK_SIZE=500
CHUNK_OVERLAP=50
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768
SIMILARITY_THRESHOLD=0.20
CHUNKS_PER_QUERY=5

# CORS & Network Permissions
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Frontend Next.js Public API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
